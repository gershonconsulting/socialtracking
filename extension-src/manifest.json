{
  "manifest_version": 3,
  "name": "Social Tracking by Gershon.AI — Post Verifier",
  "version": "0.1.0",
  "description": "Checks the LinkedIn and X pages of Gershon's campaign and internal companies in this browser and sends the posts it sees to socialtracking.gershon.ai as evidence that the agreed work was done. Never publishes. Does nothing until a signed-in Social Tracking tab connects it.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://fr.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://socialtracking.gershon.ai/*"
  ],
  "background": {
    "service_worker": "gx-boot.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Social Tracking by Gershon.AI — Verify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://fr.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "gx-visible.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://socialtracking.gershon.ai/*"
      ],
      "js": [
        "gx-bridge.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
